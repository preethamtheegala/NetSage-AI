# ===============================================
# NetSage AI — Environment Configuration
# Copy this file to .env or backend/.env if needed
# ===============================================

# Backend Server Port
PORT=5001

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/netsage-ai

# Node Environment: development | production | test
NODE_ENV=development

# AI Provider: mock | gemini
# - 'mock': 100% functional offline demo mode without API keys (Default)
# - 'gemini': Uses Google Gemini 1.5 Flash
AI_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Python Rule Checker Microservice URL
PYTHON_CHECKER_URL=http://localhost:5002

# Frontend Application URL
FRONTEND_URL=http://localhost:5173
